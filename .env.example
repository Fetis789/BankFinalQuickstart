#Модель по умолчанию
MODEL_PATH=artefacts/bank_marketing_model_catboost_bundle.joblib

#Название модели и эксперимента в mlflow
MODEL_NAME=your_model_name
EXPERIMENT_NAME=your_experiment_name

#Лучшая модель в mlflow по скору
MODEL_ALIAS=champion

#Путь к данным
DATA_PATH=datasets/{your_dataset}.csv

#URI для mlflow
MLFLOW_TRACKING_URI=http://mlflow.localhost #по умолчанию, можно менять на свою в Ingress

#URI для локальной базы данных (для запуска через uv run uvicorn)
DATABASE_URL=postgresql://{USERNAME}:{PASSWORD}@localhost:5432/{DATABASE_NAME}
LOG_LEVEL=INFO #По умолчанию, можно менять на DEBUG, WARNING, ERROR, CRITICAL
